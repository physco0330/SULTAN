# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

# Puerto del servidor API + frontend en producción
PORT=4001

# Secreto para firmar los tokens JWT del panel admin.
# Genera uno fuerte con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SULTAN_SECRET=

# Orígenes permitidos para CORS en producción (separados por comas).
# Ejemplo con despliegue conjunto (frontend servido por la API): déjalo vacío
# o pon tu dominio real:  https://tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=

# Entorno: production desactiva detalles de error en las respuestas.
NODE_ENV=production
