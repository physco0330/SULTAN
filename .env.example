# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

# Puerto del servidor API + frontend en producción
PORT=4001

# Secreto para firmar los tokens JWT del panel admin.
# Genera uno fuerte con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SULTAN_SECRET=

# --- Firestore (base de datos) ---------------------------------------
# En tu PC: ruta al JSON de la cuenta de servicio (no lo copies al repositorio).
FIREBASE_SERVICE_ACCOUNT_PATH=
# En Render: contenido completo del JSON (una sola línea).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Cloudinary (fotos de producto) ----------------------------------
# Opción 1 (recomendada): cloudinary://clave:secreto@nombre_de_nube
CLOUDINARY_URL=
# Opción 2: las tres variables por separado
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes permitidos para CORS en producción (separados por comas).
# Ejemplo con despliegue conjunto (frontend servido por la API): déjalo vacío
# o pon tu dominio real:  https://tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=

# Entorno: production desactiva detalles de error en las respuestas.
NODE_ENV=production

# Solo si no existe ningún administrador en Firestore: contraseña temporal del primer admin.
SULTAN_ADMIN_PASSWORD=

# --- Pasarela de pago ------------------------------------------------
# Adaptador activo: demo (sin cobro real) o el nombre de tu adaptador.
# Para producción crea server/payments/providers/<nombre>.mjs y registralo.
PAYMENT_PROVIDER=demo

# --- Email y notificaciones ------------------------------------------
# Proveedor de email (Resend, SendGrid, Mailgun…) via API HTTP.
MAIL_API_KEY=
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM=SULTAN BLACK <no-reply@tudominio.com>

# A donde llegan los avisos de pedidos.
ADMIN_EMAIL=
# WhatsApp del negocio con indicativo (ej. 573117317614) para el aviso de pedidos.
ADMIN_WHATSAPP=
# CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/): activa el
# bot desde el número ADMIN_WHATSAPP y pega aquí la API key para recibir avisos por WhatsApp.
CALLMEBOT_API_KEY=

